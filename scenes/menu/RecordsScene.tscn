[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu/records_scene.gd" id="1_records"]

[node name="RecordsScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_records")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.08, 0.12, 1)

[node name="MainLayout" type="VBoxContainer" parent="."]
layout_mode = 1
